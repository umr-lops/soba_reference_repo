Bootstrap: docker
From: python:3.11-slim

# Build from a checkout of this repository:
#
#     apptainer build /tmp/soba_reference_repo.sif apptainer.def
#
# then run it like the console script:
#
#     apptainer run /tmp/soba_reference_repo.sif --help
#
# The package is installed in editable mode; bundled report assets live in the package wheel
# or, in this checkout, under the repository assets directory.

%files
    pyproject.toml /opt/soba_reference_repo/pyproject.toml
    README.md /opt/soba_reference_repo/README.md
    LICENSE /opt/soba_reference_repo/LICENSE
    src /opt/soba_reference_repo/src
    assets /opt/soba_reference_repo/assets

%post
    apt-get update
    # the last two are not pulled in by the others, and the template needs both:
    # datetime2 loads tracklang (plain-generic) and the body font is Latin Modern
    apt-get install -y --no-install-recommends \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-pictures \
        texlive-fonts-recommended \
        texlive-plain-generic \
        lmodern
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir -e '/opt/soba_reference_repo[challenger]'

%environment
    export MPLBACKEND=Agg
    export PYTHONUNBUFFERED=1

%runscript
    exec soba_reference_repo "$@"

%labels
    org.soba.tool soba_reference_repo
    org.soba.description Recipe-driven reference TEST/TARGET exporter

%help
    Create a SWOT WV reference TEST/TARGET pair and report from a TOML recipe:

        apptainer run --bind /path/to/data:/data soba_reference_repo.sif \
            --recipe /data/reference.toml

    Create an ESA CCI Sea State WV CHALLENGER beside the NetCDF archive:

        apptainer exec --bind /path/to/archive:/archive:ro \
            --bind /path/to/work:/work soba_reference_repo.sif \
            soba_produce_challenger --recipe /work/challenger.toml
